  <style>
    :root {
      --accent: #99cccc;
      --text-on-media: #ffffff;
      --overlay: rgba(0,0,0,0.28);
      --overlay-hover: rgba(0,0,0,0.45);
      --circle-size-desktop: 220px;
      --circle-size-lg: 200px;
      --circle-size-md: 180px;
      --circle-size-sm: 160px;
    }

    body {
      font-family: 'Inconsolata', monospace;
    }

    a:link { color: var(--accent); }
    a:hover { color: grey; }

    /* Top nav stays the same visual language */
    .navbar.bg-light {
      background-color: #f8f9fa !important;
    }

    /* Grid holding the four circles */
    .circle-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2rem;
      justify-items: center;
      align-items: start;
      margin-top: 2.5rem;
      margin-bottom: 3rem;
    }
    @media (max-width: 1200px) {
      .circle-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width: 992px) {
      .circle-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 576px) {
      .circle-grid { grid-template-columns: 1fr; }
    }

    /* The clickable circle */
    .project-circle {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: var(--circle-size-desktop);
      height: var(--circle-size-desktop);
      border-radius: 50%;
      background: url('img/larvae.gif') center center / cover no-repeat;
      color: var(--text-on-media);
      text-decoration: none;
      overflow: hidden;
      box-shadow: 0 6px 18px rgba(0,0,0,0.15);
      transition: transform 180ms ease, box-shadow 180ms ease;
      outline: none;
    }
    @media (max-width: 1200px) {
      .project-circle { width: var(--circle-size-lg); height: var(--circle-size-lg); }
    }
    @media (max-width: 992px) {
      .project-circle { width: var(--circle-size-md); height: var(--circle-size-md); }
    }
    @media (max-width: 576px) {
      .project-circle { width: var(--circle-size-sm); height: var(--circle-size-sm); }
    }

    .project-circle:before {
      content: "";
      position: absolute;
      inset: 0;
      background: var(--overlay);
      transition: background 180ms ease;
    }

    .project-circle:hover,
    .project-circle:focus {
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(0,0,0,0.25);
    }
    .project-circle:hover:before,
    .project-circle:focus:before {
      background: var(--overlay-hover);
    }

    /* Text layers */
    .project-circle .label,
    .project-circle .name {
      position: relative;
      z-index: 1;
      padding: 0.25rem 0.5rem;
      border-radius: 0.35rem;
      letter-spacing: 0.02em;
      text-align: center;
      line-height: 1.2;
      transition: opacity 180ms ease;
      user-select: none;
    }

    /* Shows modality by default */
    .project-circle .label {
      background: rgba(0,0,0,0.35);
      font-size: 1rem;
      opacity: 1;
    }

    /* Shows project name on hover/focus */
    .project-circle .name {
      position: absolute;
      inset: auto 0 auto 0;
      margin: 0 auto;
      width: fit-content;
      font-weight: 600;
      font-size: 1.05rem;
      opacity: 0;
      transform: translateY(0);
      background: rgba(0,0,0,0.55);
    }

    .project-circle:hover .label,
    .project-circle:focus .label {
      opacity: 0;
    }
    .project-circle:hover .name,
    .project-circle:focus .name {
      opacity: 1;
    }

    /* Keyboard focus visibility */
    .project-circle:focus-visible {
      outline: 3px solid var(--accent);
      outline-offset: 4px;
    }

    /* Optional small caption under each circle */
    .circle-caption {
      text-align: center;
      margin-top: 0.5rem;
      color: #333;
      font-size: 0.95rem;
    }
  </style>
